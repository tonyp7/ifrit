# Config for a typical docker-compose.yml stack (app + db containers).
# Copy to .env (same directory as docker-compose.yml) and fill in real secrets
#
# This is distinct from backend/.env.example, which is for running the backend
# natively (outside Docker)

# --- PostgreSQL (db service) ---
POSTGRES_USER=ifrit
POSTGRES_PASSWORD=changeme-generate-a-real-secret
POSTGRES_DB=ifrit

# --- Backend (app service) ---
# Generate with e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# JSON array - must list the exact externally-visible origin(s) this app is
# served from (e.g. the domain in front of the load balancer/reverse proxy that
# terminates TLS ahead of this container).
# For a local quick test deployment, it can be set to http://localhost
CORS_ORIGINS=["https://your-domain.example"]
# Cookies require HTTPS. This container serves plain HTTP on :80 — TLS is assumed
# to terminate upstream (see docker/nginx.conf). Set true once that's in place;
# leaving it false over a real TLS-terminating proxy would ship session cookies
# without the Secure flag.
COOKIE_SECURE=true

# Bootstrap administrator. Required for the app to start (see
# backend/app/core/config.py — no default)
# Run the following command to bootstrap the admin
#   docker compose exec app python -m scripts.seed_admin
SEED_ADMIN_EMAIL=admin@your-company.example
SEED_ADMIN_PASSWORD=changeme-generate-a-real-secret

# Where uploaded files are stored inside the container. The compose file mounts a
# named volume here, so uploads survive container rebuilds. Change both together
# by changing only this value.
STORAGE_ROOT=/app/storage
# Per-file upload limit in bytes (10 MiB). docker/nginx.conf's client_max_body_size
# (11m) is configured separately and must stay slightly above this: if you raise
# this value, raise that one too and rebuild the image.
MAX_UPLOAD_BYTES=10485760
