# Copy to .env for local development (never commit the real .env)

DATABASE_URL=postgresql+asyncpg://ifrit:ifrit@localhost:5432/ifrit
# Used only by the test suite (pytest). Auto-created on first run if missing. Must
# differ from DATABASE_URL — tests freely create/drop schema here.
TEST_DATABASE_URL=postgresql+asyncpg://ifrit:ifrit@localhost:5432/ifrit_test

JWT_SECRET_KEY=dev-only-insecure-secret-key-change-me-3f8a1c9d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false

SEED_ADMIN_EMAIL=admin@ifrit.local
SEED_ADMIN_PASSWORD=changeme123
