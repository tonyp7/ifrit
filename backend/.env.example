# Copy to .env for local development

# This assumes there's a database running on the host
DATABASE_URL=postgresql+asyncpg://ifrit:ifrit@localhost:5432/ifrit

JWT_SECRET_KEY=dev-only-insecure-secret-key-change-me-3f8a1c9d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false

SEED_ADMIN_EMAIL=admin@ifrit.local
SEED_ADMIN_PASSWORD=changeme123

# Where uploaded files are stored (never served statically). Any writable directory
# for native development; the container stack uses /app/storage on a volume.
STORAGE_ROOT=/home/your-user/Projects/ifrit/app/storage
# Per-file upload limit in bytes (10 MiB). docker/nginx.conf's client_max_body_size
# must stay slightly above this.
MAX_UPLOAD_BYTES=10485760
