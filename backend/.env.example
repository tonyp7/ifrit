# Copy to .env for local development (never commit the real .env)

DATABASE_URL=postgresql+asyncpg://ifrit:ifrit@localhost:5432/ifrit
# The test suite (pytest) derives its own database from this (e.g. .../ifrit ->
# .../ifrit_test, auto-created on first run) rather than needing a config value
# of its own — see tests/conftest.py's _test_database_url().

JWT_SECRET_KEY=dev-only-insecure-secret-key-change-me-3f8a1c9d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false

SEED_ADMIN_EMAIL=admin@ifrit.local
SEED_ADMIN_PASSWORD=changeme123
