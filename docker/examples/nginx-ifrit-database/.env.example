# Config for this example's docker-compose.yml stack (app + db, behind a host
# nginx). Copy to .env (same directory as docker-compose.yml) and fill in real
# secrets; never commit the real .env.
#
# This is distinct from backend/.env.example, which is for running the backend
# natively (outside Docker).

# --- PostgreSQL (db service) ---
POSTGRES_USER=ifrit
POSTGRES_PASSWORD=changeme-generate-a-real-secret
POSTGRES_DB=ifrit

# --- Backend (app service) ---
# Generate with e.g. `openssl rand -hex 32`. Never reuse the backend/.env.example
# development value.
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# JSON array — must list the exact externally-visible origin(s) this app is
# served from (e.g. the domain in front of the load balancer/reverse proxy that
# terminates TLS ahead of this container).
CORS_ORIGINS=["https://ifrit.mydomain.com"]
COOKIE_SECURE=true

# Bootstrap administrator. Required for the app to start. A new instance has no user
# until you create this one, once, after the stack is up:
#   docker compose exec app python -m scripts.seed_admin
SEED_ADMIN_EMAIL=admin@your-company.example
SEED_ADMIN_PASSWORD=changeme-generate-a-real-secret

# Uploaded files. STORAGE_ROOT is a path inside the container, backed by the
# ifrit-storage volume. MAX_UPLOAD_BYTES is the per-file limit (10 MiB); the nginx
# client_max_body_size in nginx.conf must stay above it.
STORAGE_ROOT=/app/storage
MAX_UPLOAD_BYTES=10485760
