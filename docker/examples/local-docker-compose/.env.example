# Optional. The compose file works without any of this; copy to .env (next to
# docker-compose.yml) only to override the local-trial defaults.

# Database password. Only read the first time the database volume is created.
POSTGRES_PASSWORD=ifrit-local-trial

# Secret that signs sessions. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=local-trial-only-insecure-secret-key-do-not-use-in-production

# The administrator created by `docker compose exec app python -m scripts.seed_admin`.
# The password needs at least 12 characters.
SEED_ADMIN_EMAIL=admin@ifrit.local
SEED_ADMIN_PASSWORD=ifrit-local-trial

# Time zone of the server (IANA name, e.g. Europe/Paris). Invoice dates and the year,
# month and day in invoice numbers are taken in this zone. Optional: UTC when unset.
TZ=UTC
